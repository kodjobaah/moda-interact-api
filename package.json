{
  "name": "moda-interact-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "pretest": "npm run prisma:generate",
    "test": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node scripts/test-woocommerce-installation-postgres.mjs && node scripts/test-woocommerce-rest-read-authorization-postgres.mjs && node scripts/test-arch041-billing-postgres.mjs && node scripts/test-arch036-discount-offers-postgres.mjs && node scripts/test-arch041-cross-domain-postgres.mjs && node scripts/test-arch035-merchant-knowledge-postgres.mjs",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma",
    "test:arch026-woo-rest-read:postgres": "node scripts/test-woocommerce-rest-read-authorization-postgres.mjs",
    "test:arch036-discount-offers:postgres": "node scripts/test-arch036-discount-offers-postgres.mjs",
    "test:arch035-merchant-knowledge:postgres": "node scripts/test-arch035-merchant-knowledge-postgres.mjs"
  },
  "dependencies": {
    "@modainteract/moda-interact-shared": "2.4.1",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "yaml": "^2.9.1"
  }
}
