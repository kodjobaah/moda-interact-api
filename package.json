{
  "name": "moda-interact-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "pretest": "npm run prisma:generate",
    "test": "tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node scripts/test-arch049-shop-brand-postgres.mjs && node scripts/test-woocommerce-installation-postgres.mjs && node scripts/test-woocommerce-rest-read-authorization-postgres.mjs && node scripts/test-arch041-billing-postgres.mjs && node scripts/test-arch036-discount-offers-postgres.mjs && node scripts/test-arch041-cross-domain-postgres.mjs && node scripts/test-arch035-merchant-knowledge-postgres.mjs && node scripts/test-arch035-feature-preferences-postgres.mjs && node scripts/test-arch035-promotions-postgres.mjs && node scripts/test-arch035-woo-support-postgres.mjs && node scripts/test-arch035-usage-history-postgres.mjs && node scripts/test-arch035-knowledge-upload-postgres.mjs && node scripts/run-arch043-platform-configuration-postgres.mjs && npm run test:arch040-conversation-control:postgres && npm run test:arch040-human-send:postgres && npm run test:arch035-woo-activity:redis && npm run test:arch046-woo-consent:postgres",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma",
    "test:arch026-woo-rest-read:postgres": "node scripts/test-woocommerce-rest-read-authorization-postgres.mjs",
    "test:arch036-discount-offers:postgres": "node scripts/test-arch036-discount-offers-postgres.mjs",
    "test:arch035-merchant-knowledge:postgres": "node scripts/test-arch035-merchant-knowledge-postgres.mjs",
    "test:arch035-features:postgres": "node scripts/test-arch035-feature-preferences-postgres.mjs",
    "test:arch035-promotions:postgres": "node scripts/test-arch035-promotions-postgres.mjs",
    "test:arch035-knowledge-upload:postgres": "node scripts/test-arch035-knowledge-upload-postgres.mjs",
    "test:arch043-platform-configuration:postgres": "node scripts/run-arch043-platform-configuration-postgres.mjs",
    "test:arch040-conversation-control:postgres": "node scripts/test-arch040-woo-conversation-control-postgres.mjs",
    "test:arch040-human-send:postgres": "node scripts/test-arch040-woo-human-send-postgres.mjs",
    "test:arch047-follow-up:postgres": "node scripts/test-arch040-woo-human-send-postgres.mjs",
    "test:arch047-schema:unit": "node --test tests/scripts/arch047-canonical-schema.test.mjs",
    "test:arch035-woo-activity:unit": "tsx --test \"tests/unit/woocommerce/activity/*.test.ts\"",
    "test:arch035-woo-activity:redis": "node scripts/test-arch035-woo-activity-redis.mjs",
    "test:arch035-usage-history:unit": "tsx --test \"tests/unit/merchant/usage-history/*.test.ts\"",
    "test:arch035-usage-history:postgres": "node scripts/test-arch035-usage-history-postgres.mjs",
    "test:arch035-woo-support:unit": "tsx --test \"tests/unit/merchant/support/*.test.ts\" \"tests/unit/auth/woo-installation/authenticator.test.ts\"",
    "test:arch035-woo-support:postgres": "node scripts/test-arch035-woo-support-postgres.mjs",
    "test:arch046-woo-consent:unit": "tsx --test \"tests/unit/woocommerce/consent/*.test.ts\"",
    "test:arch046-woo-consent:postgres": "node scripts/test-arch046-woo-consent-postgres.mjs",
    "test:arch046-woo-selection:unit": "tsx --test \"tests/unit/woocommerce/recovery-selection/*.test.ts\"",
    "test:arch046-woo-selection:postgres": "node scripts/test-arch046-woo-consent-postgres.mjs",
    "test:arch049-shop-brand:unit": "tsx --test \"tests/unit/woocommerce/shop-brand/*.test.ts\"",
    "test:arch049-shop-brand:postgres": "node scripts/test-arch049-shop-brand-postgres.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@modainteract/moda-interact-shared": "2.8.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^6.2.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "yaml": "^2.9.1"
  }
}
